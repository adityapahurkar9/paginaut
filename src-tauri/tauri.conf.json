{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paginaut",
  "version": "0.9.13",
  "identifier": "app.paginaut.reader",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs --prod",
    "beforeDevCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Paginaut",
        "width": 1280,
        "height": 860,
        "minWidth": 560,
        "minHeight": 400,
        "decorations": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http://paginaut.localhost paginaut:; connect-src 'self' ipc: http://ipc.localhost http://paginaut.localhost paginaut:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../native/tessdata/*.traineddata": "tessdata/",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../tools/sign.ps1",
          "%1"
        ]
      }
    }
  }
}
