{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paginaut",
  "version": "0.7.72",
  "identifier": "app.paginaut.reader",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs --prod",
    "beforeDevCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Paginaut",
        "width": 1280,
        "height": 860,
        "minWidth": 560,
        "minHeight": 400,
        "decorations": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http://paginaut.localhost paginaut:; connect-src 'self' ipc: http://ipc.localhost http://paginaut.localhost paginaut:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../native/tessdata/*.traineddata": "tessdata/" },
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF document", "role": "Viewer", "mimeType": "application/pdf" },
      { "ext": ["xps", "oxps"], "name": "XPS document", "role": "Viewer" },
      { "ext": ["epub"], "name": "EPUB e-book", "role": "Viewer" },
      { "ext": ["cbz"], "name": "Comic book archive", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
