<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": paginaut.exe, as the Windows release workflow uploads it (a zip holding
     the one file). Paste into SignPath (project paginaut › Artifact configurations, slug "app"). Only a file
     that names itself Paginaut, at the version the run was started for, is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="paginaut.exe" product-name="Paginaut" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
